# MOMAS HTTPS reverse proxy.
#
# Install this as the HTTPS virtual host for memmcolapps.memmserve.com after
# replacing the certificate paths with the paths already used on the server.
# The important parts for live radio are proxy_http_version and the
# Upgrade/Connection headers.

map $http_upgrade $momas_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name memmcolapps.memmserve.com;

    ssl_certificate     /path/to/memmserve-fullchain.pem;
    ssl_certificate_key /path/to/memmserve-private-key.pem;

    client_max_body_size 25m;

    location /api/ {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $momas_connection_upgrade;

        # PTT calls are intentionally long-lived.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}

